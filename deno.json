{
  "workspace": [
    "./packages/*",
    "./apps/*"
  ],
  "tasks": {
    "hook": "deno run --allow-read --allow-run --allow-write https://deno.land/x/deno_hooks@0.1.1/mod.ts",
    "dev": "supabase start",
    "serve": "cd packages/supabase && supabase functions serve --no-verify-jwt",
    "studio": "open http://localhost:54323",
    "tests": "deno test --allow-all packages/supabase/functions/tests/*",
    "format": "deno fmt packages/* apps/*",
    "lint": "deno lint packages/* apps/*",
    "migration": "cd packages/supabase && supabase migration new",
    "migrate": "cd packages/supabase supabase migration up",
    "update-types-local": "supabase gen types typescript --local > packages/shared/db.types.ts",
    "update-types-linked": "supabase gen types typescript --linked > packages/shared/db.types.ts && deno run format"
  },
  "nodeModulesDir": "auto",
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.12",
    "@supabase/supabase-js": "jsr:@supabase/supabase-js@^2.49.3"
  },
  "fmt": {
    "indentWidth": 2,
    "singleQuote": false,
    "useTabs": false,
    "semiColons": true,
    "include": ["src/", "supabase/"]
  }
}
