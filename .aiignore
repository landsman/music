# AI Ignore File
# This file specifies patterns for files and directories that should be ignored by AI tools.

# Build outputs and dependencies
node_modules
dist
dist-ssr
.vite
*.local

# Large binary files
*.jpg
*.jpeg
*.png
*.gif
*.ico
*.svg
*.woff
*.woff2
*.ttf
*.eot
*.mp3
*.mp4
*.webm
*.ogg
*.pdf

# Sensitive data
.env
.env.local
*.env
apps/backend/functions/.env
cron_jobs.sql

# Generated files
packages/shared/db.types.ts
packages/web/src/i18n/locales/*/messages.js
packages/web/src/i18n/locales/*/messages.mjs

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Editor directories and files
!.idea/deno.xml
!.idea/icon.png
!.idea/icon.svg

.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
