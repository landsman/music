#!/usr/bin/env sh
. "$(dirname -- "$0")/_/hook.sh"

# Skip hooks during rebase
if [ -d "$(git rev-parse --git-path rebase-merge)" ] || \
   [ -d "$(git rev-parse --git-path rebase-apply)" ]; then
  exit 0
fi

cd apps/frontend/ && deno task extract && deno task compile

deno task format
deno task lint

