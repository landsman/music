{
  "tasks": {
    "dev": "deno run -A --node-modules-dir npm:vite",
    "build": "deno run -A --node-modules-dir npm:vite build",
    "preview": "deno run -A --node-modules-dir npm:vite preview",
    "serve": "deno run --allow-net --allow-read jsr:@std/http@1/file-server dist/",
    "extract": "bash ./scripts/lingui-extract.sh",
    "compile": "bash ./scripts/lingui-compile.sh",
    "add-language": "bash ./scripts/lingui-add-language.sh"
  },
  "compilerOptions": {
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "jsxImportSourceTypes": "@types/react"
  },
  "imports": {
    "@babel/core": "npm:@babel/core@^7.27.4",
    "@deno/vite-plugin": "npm:@deno/vite-plugin@^1.0.6",
    "@icons-pack/react-simple-icons": "npm:@icons-pack/react-simple-icons@^13.8.0",
    "@lingui/babel-plugin-lingui-macro": "npm:@lingui/babel-plugin-lingui-macro@^5.9.2",
    "@lingui/core": "npm:@lingui/core@^5.9.2",
    "@lingui/detect-locale": "npm:@lingui/detect-locale@^5.9.2",
    "@lingui/react": "npm:@lingui/react@^5.9.2",
    "@supabase/supabase-js": "npm:@supabase/supabase-js@^2.49.3",
    "@tanstack/react-query": "npm:@tanstack/react-query@^5.69.0",
    "@types/react": "npm:@types/react@^19.1.6",
    "@types/react-dom": "npm:@types/react-dom@^19.1.5",
    "@vitejs/plugin-react": "npm:@vitejs/plugin-react@^6.0.0",
    "lucide-react": "npm:lucide-react@^0.577.0",
    "pulltorefreshjs": "npm:pulltorefreshjs@^0.1.22",
    "react": "npm:react@19.2.4",
    "react-dom": "npm:react-dom@19.2.4",
    "react-hot-toast": "npm:react-hot-toast@^2.5.2",
    "react-loading-indicators": "npm:react-loading-indicators@^1.0.0",
    "use-sound": "npm:use-sound@^5.0.0",
    "usehooks-ts": "npm:usehooks-ts@^3.1.1",
    "vite": "npm:vite@^8.0.0",
    "@sentry/react": "npm:@sentry/react@^10.43.0",
    "@sentry/vite-plugin": "npm:@sentry/vite-plugin@^5.1.1"
  }
}
