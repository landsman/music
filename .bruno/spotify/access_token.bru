meta {
  name: access_token
  type: http
  seq: 2
}

post {
  url: https://accounts.spotify.com/api/token
  body: formUrlEncoded
  auth: none
}

headers {
  Content-Type: application/x-www-form-urlencoded
}

body:form-urlencoded {
  grant_type: client_credentials
  client_id: {{SPOTIFY_CLIENT_ID}}
  client_secret: {{SPOTIFY_CLIENT_SECRET}}
}
